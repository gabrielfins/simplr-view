    <userSettings>
        <SimplrView.My.MySettings>
            <setting name="id" serializeAs="String">
                <value/>
            </setting>
            <setting name="startup" serializeAs="String">
                <value>0</value>
            </setting>
        </SimplrView.My.MySettings>
    </userSettings>
